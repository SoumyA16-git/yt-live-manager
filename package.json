{
  "name": "yt-live-manager",
  "version": "1.0.0",
  "description": "24×7 YouTube Vertical Live Streaming Manager",
  "type": "module",
  "engines": { "node": ">=18.15.0" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter=spec test/unit/*.test.js",
    "test:integration": "node --test --test-reporter=spec test/integration/*.test.js",
    "hash-password": "node scripts/hash-password.js",
    "migrate": "node scripts/migrate.js",
    "status": "node scripts/status.js",
    "seek": "node scripts/seek.js",
    "youtube:login": "node scripts/youtube-login.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "playwright": "^1.49.0"
  }
}
